msgid "plugins.importexport.rsciexport.displayName"
msgstr "RSCI XML Export Plugin"

msgid "plugins.importexport.rsciexport.description"
msgstr "Export article metadata in RSCI XML."



msgid "plugins.importexport.rsciexport.export"
msgstr "Export Data"

msgid "plugins.importexport.rsciexport.export.issue"
msgstr "Export Issues"

msgid "plugins.importexport.rsciexport.export.selectIssue"
msgstr "Select an Issue to export."

msgid "plugins.importexport.rsciexport.cliUsage"
msgstr ""
"Usage: \n"
"{$scriptName} {$pluginName} export [zipFileName] [journal_path] issue [issueId]\n"

msgid "plugins.importexport.rsciexport.export.error.issueNotFound"
msgstr "No issue matched the specified issue ID \"{$issueId}\"."



msgid "plugins.importexport.rsciexport.settings.form.journalRSCITitleId"
msgstr "Journal ID in RSCI"

msgid "plugins.importexport.rsciexport.settings.form.exportSections"
msgstr "Export section names."

msgid "plugins.importexport.rsciexport.settings.form.exportArtTypeFromSectionAbbrev"
msgstr "Export article type by section abbreviations. Abbreviations must match with article types declared by RSCI. If this option is disabled or types doesn't match, then the 'RAR' type will be assigned to the articles."

msgid "plugins.importexport.rsciexport.settings.form.galleySelection"
msgstr "Full texts in the archive"

msgid "plugins.importexport.rsciexport.settings.form.galleySelection.description"
msgstr "Which PDF galleys of the articles go into the export archive. If an article has no PDF in the selected language, the PDF in the language of the article is taken, otherwise the first PDF. \"All language versions\": one PDF for each language."

msgid "plugins.importexport.rsciexport.settings.form.galleySelection.article"
msgstr "In the language of the article"

msgid "plugins.importexport.rsciexport.settings.form.galleySelection.all"
msgstr "All language versions"

msgid "plugins.importexport.rsciexport.report.title"
msgstr "Last export report"

msgid "plugins.importexport.rsciexport.report.issue"
msgstr "Issue: {$issue}, {$date}."

msgid "plugins.importexport.rsciexport.report.noProblems"
msgstr "No problems found: the cover and the full texts of all articles are in the archive."

msgid "plugins.importexport.rsciexport.report.notification"
msgstr "Problems found during the export: {$count}. See the list on the \"RSCI XML Export\" plugin page, \"Issues\" tab."

msgid "plugins.importexport.rsciexport.problem.noCover"
msgstr "The issue has no cover."

msgid "plugins.importexport.rsciexport.problem.coverFileMissing"
msgstr "A cover is set in OJS, but its file ({$file}) is not on the server, so it is not in the archive."

msgid "plugins.importexport.rsciexport.problem.noPdf"
msgstr "{$article}: no PDF galley, so the full text is not in the archive."

msgid "plugins.importexport.rsciexport.problem.otherLanguage"
msgstr "{$article}: no PDF in \"{$wanted}\", the PDF in \"{$taken}\" was taken. Check the language of the article and of the galleys."

msgid "plugins.importexport.rsciexport.problem.duplicateLanguage"
msgstr "{$article}: several PDF galleys in \"{$language}\", the first one was taken."

msgid "plugins.importexport.rsciexport.problem.fileNotFound"
msgstr "{$file}: the file is not on the server ({$path}), so it is not in the archive."

msgid "plugins.importexport.rsciexport.problem.copyFailed"
msgstr "{$file}: could not be copied into the archive ({$reason})."

msgid "plugins.importexport.rsciexport.problem.sameName"
msgstr "{$article}: the file {$file} is already used for {$otherArticle} (same pages?), the archive keeps that article's file. Correct the pages."

msgid "plugins.importexport.rsciexport.problem.article"
msgstr "pp. {$pages} \"{$title}\""

msgid "plugins.importexport.rsciexport.problem.articleNoPages"
msgstr "\"{$title}\" (ID {$id}, no pages)"

msgid "plugins.importexport.rsciexport.problem.galleyFileMissing"
msgstr "{$article}: the PDF galley file is not on the server ({$path}), so this galley was skipped."
