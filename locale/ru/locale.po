msgid "plugins.importexport.rsciexport.displayName"
msgstr "Модуль «Экспорт РИНЦ XML»"

msgid "plugins.importexport.rsciexport.description"
msgstr "Экспортирует метаданные статей в формат РИНЦ XML."



msgid "plugins.importexport.rsciexport.export"
msgstr "Экспортировать данные"

msgid "plugins.importexport.rsciexport.export.issue"
msgstr "Экспортировать выпуск"

msgid "plugins.importexport.rsciexport.export.selectIssue"
msgstr "Выберите выпуск для экспорта."

msgid "plugins.importexport.rsciexport.cliUsage"
msgstr ""
"Использование: \n"
"{$scriptName} {$pluginName} export [zipFileName] [journal_path] issue [issueId]\n"

msgid "plugins.importexport.rsciexport.export.error.issueNotFound"
msgstr "Выпуск с указанным идентификатором \"{$issueId}\" не найден."



msgid "plugins.importexport.rsciexport.settings.form.journalRSCITitleId"
msgstr "Идентификатор журнала в РИНЦ"

msgid "plugins.importexport.rsciexport.settings.form.exportSections"
msgstr "Экспортировать разделы выпуска (используются только названия разделов)"

msgid "plugins.importexport.rsciexport.settings.form.exportArtTypeFromSectionAbbrev"
msgstr "Экспортировать тип статьи по значению аббревиатуры раздела основного языка сайта. Аббревиатуры должны совпадать с типами статей, определенными в РИНЦ. Если опция не включена или тип не определен в РИНЦ, то статье будет присваиваться тип 'RAR' (Научная статья)."

msgid "plugins.importexport.rsciexport.settings.form.galleySelection"
msgstr "Полные тексты в архиве"

msgid "plugins.importexport.rsciexport.settings.form.galleySelection.description"
msgstr "Какие PDF-гранки статей класть в архив выгрузки. Если у статьи нет PDF на выбранном языке, берётся PDF на языке статьи, а если нет и её — первая PDF по порядку. «Все языковые версии» — по одной PDF на каждый язык."

msgid "plugins.importexport.rsciexport.settings.form.galleySelection.article"
msgstr "На языке статьи"

msgid "plugins.importexport.rsciexport.settings.form.galleySelection.all"
msgstr "Все языковые версии"

msgid "plugins.importexport.rsciexport.report.title"
msgstr "Отчёт о последней выгрузке"

msgid "plugins.importexport.rsciexport.report.issue"
msgstr "Выпуск: {$issue}, {$date}."

msgid "plugins.importexport.rsciexport.report.noProblems"
msgstr "Проблем не найдено: обложка и полные тексты всех статей попали в архив."

msgid "plugins.importexport.rsciexport.report.notification"
msgstr "При выгрузке найдено проблем: {$count}. Список — на странице модуля «Экспорт РИНЦ XML», вкладка «Выпуски»."

msgid "plugins.importexport.rsciexport.problem.noCover"
msgstr "У выпуска нет обложки."

msgid "plugins.importexport.rsciexport.problem.coverFileMissing"
msgstr "Обложка указана в OJS, но её файла ({$file}) нет на сервере — в архив она не попала."

msgid "plugins.importexport.rsciexport.problem.noPdf"
msgstr "{$article}: нет PDF-гранки — полный текст в архив не попал."

msgid "plugins.importexport.rsciexport.problem.otherLanguage"
msgstr "{$article}: нет PDF на языке «{$wanted}», взята PDF на языке «{$taken}». Проверьте язык статьи и язык гранок."

msgid "plugins.importexport.rsciexport.problem.duplicateLanguage"
msgstr "{$article}: несколько PDF-гранок на языке «{$language}» — в архив взята первая."

msgid "plugins.importexport.rsciexport.problem.fileNotFound"
msgstr "{$file}: файла нет на сервере ({$path}) — в архив он не попал."

msgid "plugins.importexport.rsciexport.problem.copyFailed"
msgstr "{$file}: не удалось скопировать в архив ({$reason})."

msgid "plugins.importexport.rsciexport.problem.sameName"
msgstr "{$article}: файл {$file} уже взят для статьи {$otherArticle} (одинаковые страницы?) — в архиве остался файл той статьи. Исправьте страницы."

msgid "plugins.importexport.rsciexport.problem.article"
msgstr "с. {$pages} «{$title}»"

msgid "plugins.importexport.rsciexport.problem.articleNoPages"
msgstr "«{$title}» (ID {$id}, страницы не указаны)"

msgid "plugins.importexport.rsciexport.problem.galleyFileMissing"
msgstr "{$article}: файла PDF-гранки нет на сервере ({$path}) — эта гранка пропущена."

msgid "plugins.importexport.rsciexport.problem.noDateReceived"
msgstr "{$article}: в OJS нет даты поступления статьи — в XML она не передана."

msgid "plugins.importexport.rsciexport.problem.receivedAfterPublished"
msgstr "{$article}: дата поступления ({$received}) позже даты публикации ({$published}). Проверьте даты статьи: возможно, это дата переноса статьи в OJS."
